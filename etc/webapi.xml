<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/magedrop/ping" method="GET">
        <service class="MageDrop\Magento2\Api\PingInterface" method="ping"/>
        <resources>
            <resource ref="MageDrop_Magento2::api"/>
        </resources>
    </route>
    <route url="/V1/magedrop/capabilities" method="GET">
        <service class="MageDrop\Magento2\Api\EntityManagementInterface" method="capabilities"/>
        <resources>
            <resource ref="MageDrop_Magento2::api"/>
        </resources>
    </route>
    <route url="/V1/magedrop/entity/:type/:id" method="GET">
        <service class="MageDrop\Magento2\Api\EntityManagementInterface" method="getState"/>
        <resources>
            <resource ref="MageDrop_Magento2::api"/>
        </resources>
    </route>
    <route url="/V1/magedrop/apply" method="POST">
        <service class="MageDrop\Magento2\Api\EntityManagementInterface" method="apply"/>
        <resources>
            <resource ref="MageDrop_Magento2::api"/>
        </resources>
    </route>
</routes>
