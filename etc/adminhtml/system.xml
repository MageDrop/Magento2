<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="magedrop" translate="label" sortOrder="400" class="magedrop-tab">
            <label>MageDrop</label>
        </tab>
        <section id="magedrop" translate="label" type="text" sortOrder="10" showInDefault="1">
            <label>Connection</label>
            <tab>magedrop</tab>
            <resource>MageDrop_Magento2::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1">
                <label>API Connection</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_token" translate="label comment" type="obscure" sortOrder="20" showInDefault="1">
                    <label>Module Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Copy this from your MageDrop dashboard under Store > Show Module Token</comment>
                </field>
                <field id="api_url" translate="label comment" type="text" sortOrder="30" showInDefault="1">
                    <label>API URL Override</label>
                    <comment>Leave empty to use https://www.magedrop.com/api. Only set this when pointing at a staging or local MageDrop instance.</comment>
                </field>
            </group>
            <group id="media" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>Media Cleanup</label>
                <field id="cleanup_enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1">
                    <label>Clean Up Unused Media</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Daily, deletes images MageDrop kept that nothing uses any more: uploads from releases that were never deployed, and gallery images a deploy removed from a product.</comment>
                </field>
                <field id="retention_days" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Keep For (Days)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <comment>Images removed by a deploy are kept this long so rolling the release back can restore them. Rolling back after this period restores the gallery without those images.</comment>
                    <depends>
                        <field id="cleanup_enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
