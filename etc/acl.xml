<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="MageDrop_Magento2::magedrop" title="MageDrop" sortOrder="100">
                    <resource id="MageDrop_Magento2::releases" title="Releases" sortOrder="10"/>
                    <resource id="MageDrop_Magento2::config" title="Configuration" sortOrder="20"/>
                    <resource id="MageDrop_Magento2::api" title="API (deploy &amp; rollback access for the MageDrop integration)" sortOrder="30"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
